# Server only. Never expose these as client-side build variables.
LIVE_SEARCH_ENABLED=false
# nearby discovers actual restaurants globally; verified catalog is optional legacy mode.
DISCOVERY_MODE=nearby
DEMO_PREVIEW_ENABLED=false
NATIVE_API_ENABLED=false
GOOGLE_PLACES_API_KEY=
# JSON catalog, reviewed venue/menu data only. Do not use test fixtures as real data.
VERIFIED_CATALOG=

# Public HTTPS origin embedded in native live beta (no keys, path or credentials).
BYTEBUDGET_API_BASE=
