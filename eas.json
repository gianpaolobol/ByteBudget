{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "demo": {
      "distribution": "store",
      "env": {
        "BYTEBUDGET_MODE": "demo"
      },
      "ios": {
        "scheme": "App",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "node": "24.11.0"
    },
    "demo-apk": {
      "extends": "demo",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "demo": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6832104168"
      }
    }
  }
}
